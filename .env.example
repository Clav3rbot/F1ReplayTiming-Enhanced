# F1 Replay Timing — Environment Variables
# Copy to .env and fill in your values

PORT=8000
DATA_DIR=/data

# Storage: "local" (default) or "r2"
# Local stores computed session data on disk. R2 reads pre-computed data from Cloudflare R2.
STORAGE_MODE=local

# Cloudflare R2 (only needed when STORAGE_MODE=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=f1timingdata

# F1 TV account (Access or higher): F1's timing archive needs it since October 2026.
# FastF1 signs in with these to download sessions, team radio and mini-sectors.
F1_USERNAME=
F1_PASSWORD=

# Optional — authentication
# AUTH_ENABLED=true
# AUTH_PASSPHRASE=your-passphrase

# Optional — photo sync feature (requires OpenRouter API key)
# OPENROUTER_API_KEY=your-key-here

# Optional — team radio captions. Unset, they're chosen in Settings > Team Radio.
# Whisper models: tiny.en, base.en, small.en (default), medium.en, large-v3-turbo
# TEAM_RADIO_MODEL=small.en
# TEAM_RADIO_LIVE_MODEL=small.en

# Auto-precompute: which session types to fetch in the background during race weekends.
# Runs every 30 minutes Fri–Mon and downloads any matching session as soon as F1
# publishes data. Sessions not in this set are still fetched on-demand the first
# time you click them (with the usual 1–3 minute wait).
#   off        — disable, fetch everything on-demand only
#   race       — race + sprint
#   race+qual  — race, sprint, qualifying, sprint qualifying (default)
#   all        — every session including practice
AUTO_PRECOMPUTE=race+qual

# Cloudflare Worker proxy for F1 SignalR and archive downloads (needed when hosting
# on data-centre IPs that F1 blocks — e.g. Oracle Cloud, AWS, GCP — even with an
# F1 TV sign-in: the worker forwards the F1 TV token).
# Deploy cloudflare-worker/f1-signalr-proxy.js as a free Cloudflare Worker,
# then set this to your worker's URL (no trailing slash).
# F1_SIGNALR_PROXY=https://f1-signalr-proxy.<your-subdomain>.workers.dev

# Only needed for pre-compute script (not required at runtime)
# FASTF1_CACHE_DIR=/data/fastf1-cache
